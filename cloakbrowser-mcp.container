[Unit]
Description=CloakBrowser MCP — stealth Chromium MCP server
After=network-online.target

[Container]
Image=isklv/cloakbrowser-mcp:latest
ContainerName=cloakbrowser-mcp

# Ports
PublishPort=3000:3000
PublishPort=8931:8931

# Environment
Environment=CDP_PORT=8931
Environment=MCP_PORT=3000
Environment=HEADLESS=true
Environment=PROXY_SERVER=
Environment=ISOLATED=false

# Resources
MemoryLimit=4G
CPUS=2

# Healthcheck
HealthcheckCmd=curl -sf http://127.0.0.1:8931/json/version || exit 1
HealthcheckInterval=10s
HealthcheckTimeout=5s
HealthcheckStartPeriod=15s
HealthcheckRetries=3

# Restart
Restart=unless-stopped
RestartSec=5

# Rootless / security
Readonly=true
NoNewPrivileges=true

# Storage (optional — uncomment if needed)
# Volume=storage-state:/app/storage-state:ro

# DNS
DNSSearch=.

[Install]
WantedBy=default.target
